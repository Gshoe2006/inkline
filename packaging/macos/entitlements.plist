<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Inkline.app's entitlements under the hardened runtime, which notarization requires (packaging/macos/sign.py).
     Python needs both: ctypes and libffi make executable memory without a JIT entitlement, and the PyInstaller
     bootloader loads Python and the extension modules from the bundle. Nothing else (no camera, network server,
     or sandbox exceptions). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
