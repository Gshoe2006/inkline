# Maintainer: Inkline
pkgname=inkline
pkgver=@VERSION@
pkgrel=1
pkgdesc="Convert photos or generate black & white images for printing"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'python-numpy')
optdepends=('cups: printing to local and network printers')
source=('inkline.py' 'inkline.svg' 'inkline.desktop' 'inkline-mime.xml' 'VERSION' 'LICENSE' 'CHANGELOG.md' 'inkline-app.tar.gz' 'inkline-icons.tar.gz')
sha256sums=()

package() {
  for f in $(find inkengine inkapp -name '*.py' -o -name '*.gz' -o -name '*.json' -o -name '*.ttf' -o -name 'OFL*.txt' | grep -v __pycache__); do
    install -Dm644 "$f" "$pkgdir/usr/share/inkline/$f"
  done
  install -Dm755 inkline.py      "$pkgdir/usr/share/inkline/inkline.py"
  install -Dm644 inkline.svg     "$pkgdir/usr/share/inkline/inkline.svg"
  install -Dm644 VERSION         "$pkgdir/usr/share/inkline/VERSION"
  install -Dm644 CHANGELOG.md    "$pkgdir/usr/share/inkline/CHANGELOG.md"   # Help → What's new
  echo arch | install -Dm644 /dev/stdin "$pkgdir/usr/share/inkline/install-kind"   # how updates install
  install -Dm644 LICENSE         "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 inkline.svg     "$pkgdir/usr/share/icons/hicolor/scalable/apps/inkline.svg"
  install -Dm644 inkline.desktop "$pkgdir/usr/share/applications/inkline.desktop"
  install -Dm644 inkline-mime.xml "$pkgdir/usr/share/mime/packages/inkline.xml"   # .inkline projects (pacman's hook updates the database)
  install -Dm644 hicolor/scalable/mimetypes/application-x-inkline-project.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-inkline-project.svg"
  for png in hicolor/*/apps/inkline.png; do
    install -Dm644 "$png" "$pkgdir/usr/share/icons/$png"
  done
  install -dm755 "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec python3 /usr/share/inkline/inkline.py "$@"\n' > "$pkgdir/usr/bin/inkline"
  chmod 755 "$pkgdir/usr/bin/inkline"
}
