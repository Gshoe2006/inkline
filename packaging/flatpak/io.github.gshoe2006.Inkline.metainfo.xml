<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gshoe2006.Inkline</id>
  <name>Inkline</name>
  <summary>Make black and white pages to print</summary>
  <developer id="io.github.gshoe2006">
    <name>Gshoe2006</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Inkline makes colouring pages, puzzles and black and white photo prints, ready to print at true paper size.</p>
    <ul>
      <li>Make one up: mandalas, mazes, dot-to-dots, sudoku, kakuro, nonograms, spot the difference, word search, name pages in bubble letters, woven tiles, contours and flow lines</li>
      <li>Convert a photo: dithering, halftone dots, engraving lines, stippling, a line drawing to colour in, colour by number or a nonogram</li>
      <li>Booklets and photo books with covers, page numbers and answer pages, including fold-and-staple books; build a booklet page by page, each page with its own pattern</li>
      <li>Save your work as a project file, with its photos inside, to open again later</li>
      <li>Posters across several sheets, and a printer test page</li>
      <li>Print, or save as PDF, PNG or SVG</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.gshoe2006.Inkline.desktop</launchable>
  <provides>
    <mediatype>application/x-inkline-project</mediatype>
  </provides>
  <url type="homepage">https://github.com/Gshoe2006/inkline</url>
  <url type="bugtracker">https://github.com/Gshoe2006/inkline/issues</url>
  <url type="vcs-browser">https://github.com/Gshoe2006/inkline</url>
  <branding>
    <color type="primary" scheme_preference="light">#a7e3f2</color>
    <color type="primary" scheme_preference="dark">#0b4f66</color>
  </branding>
